# Maintainer: Fraol Teshome <fraolteshome444@gmail.com>
pkgname=alphabet-lang
pkgver=2.3.6
pkgrel=1
pkgdesc="Multilingual programming language — code in English, Amharic, Spanish, French, or German"
arch=('x86_64')
url="https://github.com/fraol163/alphabet"
license=('MIT')
depends=('gcc-libs')
# No third-party dependencies — alphabet ships its own JSON parser.
makedepends=('cmake')
source=("$url/archive/v$pkgver.tar.gz")
# sha256sums is updated by the release pipeline. For local builds, run:
#   updpkgsums
# or compute manually:
#   curl -fsSL https://github.com/fraol163/alphabet/archive/v2.3.6.tar.gz | sha256sum
sha256sums=('SKIP')

build() {
  cd "$srcdir/alphabet-$pkgver"
  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "$srcdir/alphabet-$pkgver/build"
  ctest --output-on-failure
}

package() {
  cd "$srcdir/alphabet-$pkgver"
  cmake --install build --prefix "$pkgdir/usr"

  # Install stdlib
  install -dm755 "$pkgdir/usr/share/alphabet"
  cp -r stdlib "$pkgdir/usr/share/alphabet/"
  cp -r examples "$pkgdir/usr/share/alphabet/"
  cp -r learn "$pkgdir/usr/share/alphabet/"

  # Install license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
