#alphabet<en>
@ list_sum, list_avg, list_min, list_max, list_median, list_mode, list_flatten_deep, list_chunk, list_zip_with

m 5 list_sum(5 lst) {
  r z.sum(lst)
}

m 5 list_avg(5 lst) {
  r z.avg(lst)
}

m 5 list_min(5 lst) {
  i (z.z.len(lst) == 0) { r null }
  5 min_val = lst[0]
  l (5 i = 1 : i < z.z.len(lst) : i = i + 1) {
    i (lst[i] < min_val) {
      min_val = lst[i]
    }
  }
  r min_val
}

m 5 list_max(5 lst) {
  i (z.z.len(lst) == 0) { r null }
  5 max_val = lst[0]
  l (5 i = 1 : i < z.z.len(lst) : i = i + 1) {
    i (lst[i] > max_val) {
      max_val = lst[i]
    }
  }
  r max_val
}

m 5 list_median(5 lst) {
  5 sorted = z.sort(lst)
  5 sz = z.z.len(sorted)
  i (sz == 0) { r 0 }
  i (sz % 2 == 1) {
    r sorted[sz / 2]
  }
  r (sorted[sz / 2 - 1] + sorted[sz / 2]) / 2
}

m 5 list_mode(5 lst) {
  5 counts = {}
  l (val : lst) {
    i (z.is_null(counts[val])) {
      counts[val] = 1
    } e {
      counts[val] = counts[val] + 1
    }
  }
  5 max_count = 0
  5 mode_val = null
  l (k : z.keys(counts)) {
    i (counts[k] > max_count) {
      max_count = counts[k]
      mode_val = k
    }
  }
  r mode_val
}

m 13 list_flatten_deep(5 lst) {
  // Iterative deep flatten using a worklist. The recursive version
  // blows the VM's MAX_CALL_DEPTH=1000 when lists are deeply nested;
  // the iterative form is also faster and avoids the closure-locals
  // capture bug in the current VM.
  5 result = []
  13 stack = [lst]
  13 out_stack = []
  l (z.len(stack) > 0) {
    13 top = stack[z.len(stack) - 1]
    5 new_len = z.len(stack) - 1
    l (5 i = 0 : i < new_len : i = i + 1) {
      append(out_stack, stack[i])
    }
    stack = out_stack
    out_stack = []
    i (z.type(top) == "list") {
      l (item : top) {
        append(stack, item)
      }
    } e {
      append(result, top)
    }
  }
  r result
}

m 13 list_chunk(5 lst, 5 size) {
  5 result = []
  5 chunk = []
  l (5 i = 0 : i < z.z.len(lst) : i = i + 1) {
    append(chunk, lst[i])
    i (z.z.len(chunk) == size) {
      append(result, chunk)
      chunk = []
    }
  }
  i (z.z.len(chunk) > 0) {
    append(result, chunk)
  }
  r result
}

m 13 list_zip_with(5 lst1, 5 lst2, 5 fn) {
  5 result = []
  5 len = z.z.len(lst1)
  i (z.z.len(lst2) < len) { len = z.z.len(lst2) }
  l (5 i = 0 : i < len : i = i + 1) {
    append(result, fn(lst1[i], lst2[i]))
  }
  r result
}
