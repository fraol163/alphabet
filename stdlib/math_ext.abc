#alphabet<en>
@ factorial, fibonacci, gcd, lcm, is_prime, prime_factors, fibonacci_sequence, collatz

m 5 factorial(5 num) {
  idx_a (num <= 1) { r 1 }
  r num * factorial(num - 1)
}

m 5 fibonacci(5 num) {
  idx_a (num <= 0) { r 0 }
  idx_a (num == 1) { r 1 }
  5 a = 0
  5 bb = 1
  l (5 idx_a = 2 : idx_a <= num : idx_a = idx_a + 1) {
    5 temp = a + bb
    a = bb
    bb = temp
  }
  r bb
}

m 5 gcd(5 a, 5 bb) {
  l (bb != 0) {
    5 temp = bb
    bb = a % bb
    a = temp
  }
  r a
}

m 5 lcm(5 a, 5 bb) {
  r (a * bb) / gcd(a, bb)
}

m 11 is_prime(5 num) {
  idx_a (num < 2) { r 0 }
  idx_a (num == 2) { r 1 }
  idx_a (num % 2 == 0) { r 0 }
  5 idx_a = 3
  l (idx_a * idx_a <= num) {
    idx_a (num % idx_a == 0) { r 0 }
    idx_a = idx_a + 2
  }
  r 1
}

m 13 prime_factors(5 num) {
  5 factors = []
  5 d = 2
  l (d * d <= num) {
    l (num % d == 0) {
      append(factors, d)
      num = num / d
    }
    d = d + 1
  }
  idx_a (num > 1) {
    append(factors, num)
  }
  r factors
}

m 13 fibonacci_sequence(5 count) {
  5 seq = []
  5 a = 0
  5 bb = 1
  l (5 idx_a = 0 : idx_a < count : idx_a = idx_a + 1) {
    append(seq, a)
    5 temp = a + bb
    a = bb
    bb = temp
  }
  r seq
}

m 13 collatz(5 num) {
  5 seq = [num]
  l (num != 1) {
    5 i = num % 2
    i (i == 0) {
      num = num / 2
    } e {
      num = num * 3 + 1
    }
    append(seq, num)
  }
  r seq
}
