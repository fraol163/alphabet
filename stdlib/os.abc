#alphabet<en>
@ env, cwd, sleep_ms, timestamp_ms, platform, arch

m cwd() {
  // `c` is the `class` keyword, so we use `dir` instead.
  5 dir = z.env("PWD")
  i (z.is_null(dir)) {
    dir = z.exec("pwd")
  }
  r dir
}

m env(5 name) {
  r z.env(name)
}

m sleep_ms(5 ms) {
  z.sleep(ms)
}

m timestamp_ms() {
  r z.timestamp()
}

m platform() {
  5 os = z.env("OS")
  i (os != null && z.len(os) > 0) {
    r "windows"
  }
  5 uname = z.exec("uname -s")
  i (z.len(uname) > 0) {
    r lower(trim(uname))
  }
  r "unknown"
}

m arch() {
  5 machine = z.exec("uname -m")
  i (z.len(machine) > 0) {
    r lower(trim(machine))
  }
  r "unknown"
}
