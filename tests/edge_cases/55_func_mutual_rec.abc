#alphabet<en>
// Edge Case 55: Mutual recursion
m 11 is_even(11 n_val) { i (n_val == 0) { r 1 } r is_odd(n_val - 1) }
m 11 is_odd(11 n_val) { i (n_val == 0) { r 0 } r is_even(n_val - 1) }
i (is_even(10) == 1 && is_odd(7) == 1 && is_even(3) == 0) { z.o("PASS:func_55_mutual_rec") } e { z.o("FAIL:func_55_mutual_rec") }
